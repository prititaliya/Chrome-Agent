{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "wxt.config.ts",
    "playwright.config.ts",
    "entrypoints/**/*",
    "src/**/*",
    "tests/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
