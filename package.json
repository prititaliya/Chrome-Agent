{
  "name": "comet-assistant",
  "version": "0.0.1",
  "private": true,
  "description": "Comet-like AI browser assistant (Chrome MV3 side panel)",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.3.4",
    "vitest": "^2.1.3",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dom-accessibility-api": "^0.7.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
