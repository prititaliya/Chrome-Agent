{
  "name": "comet-like-browser-assistant",
  "version": "0.0.1",
  "private": true,
  "description": "Comet-like AI browser assistant (Chrome MV3 + Firefox MV3, one WXT codebase)",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "wxt",
    "dev:ff": "wxt -b firefox",
    "build": "wxt build -b chrome && wxt build -b firefox",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "mock": "node scripts/mock.mjs",
    "dev:reload": "node scripts/dev-reload.mjs",
    "e2e": "playwright test",
    "gates": "node scripts/check-manifest.mjs && node scripts/check-no-sync.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.3.4",
    "vitest": "^2.1.3",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dom-accessibility-api": "^0.7.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  }
}
